  "query": "\n        SELECT id, filename, content_type, size_bytes, s3_object_key, expires_at \n        FROM uploads \n        WHERE expires_at < NOW()\n        AND id > $1\n        ORDER BY id DESC\n        LIMIT $2\n        ",
